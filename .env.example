# Copy this file to ".env" for local development and fill in real values.
# In production (Render / Cloud Run / Fly.io) set these as environment variables.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# Never run with DEBUG=True in production.
DJANGO_DEBUG=True

# Comma-separated hostnames the app is served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Full origins (scheme + host) trusted for CSRF on HTTPS deployments.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Redirect HTTP -> HTTPS in production (set False if the platform does it for you).
DJANGO_SECURE_SSL_REDIRECT=True
